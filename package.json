{
  "name": "zentro",
  "version": "1.0.0",
  "private": true,
  "description": "ZENTRO - multilingual everyday tools and AI workspace",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.js",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "desktop:build:win": "electron-builder --win nsis --x64 --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "@capacitor/core": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/android": "^8.6.2",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.zentro.desktop",
    "productName": "ZENTRO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "zentro-windows-setup.${ext}"
  }
}